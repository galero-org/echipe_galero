---
import Layout from "../layouts/Layout.astro";
export const prerender = false;

const organizatori = [
  { nume: "Deloiu Florin", telefon: "40746370722" },
  { nume: "Ioviță Lucian", telefon: "40741762711" },
  { nume: "Apetroaei Cezar", telefon: "40774005451" },
];

const linkInvitatieWhatsAppGrup =
  "https://chat.whatsapp.com/DYVYICECUZO47kOmp2D7up";

const googleMapsEmbedUrl =
  "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2712.634062684668!2d27.60597687689485!3d47.16019862115091!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40cafc75c2a0809d%3A0x46027052a10136a6!2sMagic%20Sport%20Center!5e0!3m2!1sen!2sro!4v1715159463021!5m2!1sen!2sro";
---

<Layout title="Despre Galero Football Iași">
  <div class="min-h-screen bg-slate-50 px-4 py-10 md:px-6 lg:px-8">
    <main class="mx-auto flex max-w-5xl flex-col gap-6">
      <section
        class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm md:p-10"
      >
        <div
          class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between"
        >
          <div class="max-w-2xl">
            <p
              class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-slate-500"
            >
              Despre comunitate
            </p>
            <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl">
              Fotbal Galero Iași
            </h1>
            <p class="mt-4 text-lg leading-8 text-slate-600">
              Un grup simplu, prietenos și activ, unde meciurile sunt mai mult
              decât un joc: sunt șansa de a petrece timp bun și de a ajuta
              comunitatea să se unească.
            </p>
          </div>
          <img
            src="/images/galero.jpg"
            alt="Galero Football Logo"
            class="h-24 w-auto rounded-2xl object-contain"
          />
        </div>
      </section>

      <section
        class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm md:p-10"
      >
        <div class="grid gap-6 md:grid-cols-[1.1fr_0.9fr] md:items-start">
          <div>
            <h2 class="text-2xl font-semibold text-slate-900">Când și unde?</h2>
            <ul class="mt-4 space-y-3 text-slate-600">
              <li><strong>Sâmbăta:</strong> 20:00 – 22:00</li>
              <li>
                <strong>Locație:</strong> Terenul Magic Sport Center, Tudor Vladimirescu,
                Iași
              </li>
            </ul>
          </div>
          <div class="overflow-hidden rounded-2xl border border-slate-200">
            <iframe
              class="h-64 w-full border-0"
              src={googleMapsEmbedUrl}
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </section>

      <section
        class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm md:p-10"
      >
        <div
          class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
        >
          <div class="max-w-2xl">
            <h2 class="text-2xl font-semibold text-slate-900">
              Vino în echipă
            </h2>
            <p class="mt-2 text-slate-600">
              Ești gata să ni te alături pe teren? Intră în grupul de WhatsApp
              pentru a fi la curent cu organizarea meciurilor.
            </p>
          </div>
          <a
            href={linkInvitatieWhatsAppGrup}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-emerald-600 px-5 py-3 font-medium text-white transition hover:bg-emerald-700"
          >
            Alătură-te grupului WhatsApp
          </a>
        </div>
      </section>

      <section
        class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm md:p-10"
      >
        <h2 class="text-2xl font-semibold text-slate-900">Organizatorii</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {
            organizatori.map((org) => (
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-center">
                <img
                  src={`https://ui-avatars.com/api/?name=${org.nume.replace(" ", "+")}&background=random&color=fff&size=96`}
                  alt={org.nume}
                  class="mx-auto mb-3 h-20 w-20 rounded-full border-4 border-white shadow-sm"
                />
                <h3 class="font-semibold text-slate-900">{org.nume}</h3>
                <a
                  href={`https://wa.me/${org.telefon}?text=${encodeURIComponent(`Salut ${org.nume.split(" ")[1]}, aș dori mai multe detalii despre competiția de fotbal Galero.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-2 inline-block text-sm font-medium text-emerald-600 hover:text-emerald-700"
                >
                  Contactează pe WhatsApp
                </a>
              </div>
            ))
          }
        </div>
      </section>
    </main>
  </div>
</Layout>
