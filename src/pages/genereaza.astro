---
import Layout from "../layouts/Layout.astro";
import { supabase } from "../lib/supabase";
import TeamOrchestrator from "../components/TeamOrchestrator";

export const prerender = false;

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (!accessToken?.value || !refreshToken?.value) {
  return Astro.redirect("/signin");
}

const { data: sessionData, error: sessionError } =
  await supabase.auth.setSession({
    access_token: accessToken.value,
    refresh_token: refreshToken.value,
  });

if (sessionError || !sessionData?.user) {
  Astro.cookies.delete("sb-access-token", { path: "/" });
  Astro.cookies.delete("sb-refresh-token", { path: "/" });
  return Astro.redirect("/signin");
}

const { data: allPlayers, error } = await supabase.from("players").select("*");
if (error) {
  console.error("Error fetching players:", error.message);
  // Poate afișa un mesaj de eroare utilizatorului sau redirecționa
  return Astro.redirect("/error-page"); // Exemplu
}

const { data: editions, error: editionsError } = await supabase
  .from("editions")
  .select("id, numar_editie")
  .order("numar_editie", { ascending: false });

const lastEdition = editions && editions.length > 0 ? editions[0] : null;
// Modificare aici: preia numar_editie de la lastEdition
const numarEditie: number = lastEdition?.numar_editie ?? 0;

const { data: registrations, error: regError } = await supabase
  .from("registrations")
  .select("player_id")
  .eq("edition_id", lastEdition?.id ?? "")
  .eq("status", "inscris");

if (regError) {
  console.error("Error fetching registrations:", regError.message);
  return Astro.redirect("/error-page");
}

const registeredPlayerIds = registrations.map((r) => r.player_id);
---

<Layout title="Generare Echipe Echilibrate">
  <div class="p-6 max-w-screen-xl mx-auto">
    <h1 class="text-3xl font-bold mb-8 text-center">
      ⚽ Generează Echipe de Fotbal ⚽
    </h1>
    {
      allPlayers && allPlayers.length > 0 ? (
        <TeamOrchestrator
          client:load
          allPlayers={allPlayers}
          registeredPlayerIds={registeredPlayerIds}
          edition_id={numarEditie}
        />
      ) : (
        <p class="text-center text-red-500">
          Nu s-au putut încărca jucătorii sau nu există jucători în baza de
          date.
        </p>
      )
    }
  </div>
</Layout>
