{
  "extends": "astro/tsconfigs/strict",
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts", // Important pentru src/globals.d.ts
    "src/**/*.astro"
    // Poți adăuga și "env.d.ts" dacă îl folosești direct
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}