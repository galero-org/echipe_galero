---
export const prerender = true;

import Layout from "../layouts/Layout.astro";

const { cookies } = Astro;
const error = Astro.url.searchParams.get("error");
const registered = Astro.url.searchParams.get("registered") === "1";

const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  return redirect("/dashboard");
}
---

<Layout title="Sign in">
  <div
    class="flex min-h-[calc(100vh-5rem)] items-center justify-center bg-grayLight px-4 py-8 font-text sm:px-6"
  >
    <div
      class="w-full max-w-md space-y-6 rounded-2xl bg-white p-6 shadow-xl sm:p-8"
    >
      <div class="space-y-2 text-center">
        <h1 class="text-3xl font-bold text-primary">Sign in</h1>
        <p class="text-sm text-text">Intră în contul tău Galero.</p>
      </div>
      {
        registered && (
          <p
            class="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800"
            role="status"
          >
            Cont creat. Verifică emailul dacă proiectul cere confirmare, apoi
            autentifică-te.
          </p>
        )
      }
      {
        error && (
          <p
            class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
            role="alert"
          >
            {error === "invalid_credentials"
              ? "Emailul sau parola sunt incorecte."
              : error === "missing_credentials"
                ? "Completează emailul și parola."
                : error === "session_expired_mw"
                  ? "Sesiunea a expirat. Autentifică-te din nou."
                  : "Autentificarea nu a reușit. Încearcă din nou."}
          </p>
        )
      }
      <p class="text-center text-sm text-text">
        New here? <a href="/register" class="text-accent hover:underline"
          >Create an account</a
        >
      </p>

      <form action="/api/auth/signin" method="post" class="space-y-4">
        <div>
          <label for="email" class="block mb-1 text-sm font-medium text-text"
            >Email</label
          >
          <input
            type="email"
            name="email"
            id="email"
            placeholder="you@example.com"
            required
            autocomplete="email"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent"
          />
        </div>

        <div>
          <label for="password" class="block mb-1 text-sm font-medium text-text"
            >Password</label
          >
          <input
            type="password"
            name="password"
            id="password"
            placeholder="Your password"
            required
            autocomplete="current-password"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent"
          />
        </div>

        <button
          type="submit"
          class="w-full rounded-lg bg-primary px-4 py-3 font-semibold text-white transition hover:bg-opacity-90 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
        >
          Login
        </button>
      </form>

      <div class="relative flex items-center justify-center">
        <span class="absolute w-full border-t border-gray-300 top-1/2"></span>
        <span class="bg-white px-2 text-sm text-text z-10">OR</span>
      </div>

      <form action="/api/auth/signin" method="post">
        <button
          name="provider"
          value="google"
          type="submit"
          class="flex w-full items-center justify-center gap-2 rounded-lg border border-gray-300 px-4 py-3 transition hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
        >
          <img
            src="https://www.svgrepo.com/show/475656/google-color.svg"
            alt="Google"
            class="w-5 h-5"
          />
          <span>Sign in with Google</span>
        </button>
      </form>
    </div>
  </div>
</Layout>
