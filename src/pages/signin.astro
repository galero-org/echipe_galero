---
import Layout from "../layouts/Layout.astro";

const { cookies, redirect } = Astro;

const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

if (accessToken && refreshToken) {
  return redirect("/dashboard");
}

export const prerender = false;
---

<Layout title="Sign in">
  <div
    class="flex items-center justify-center min-h-screen bg-grayLight font-text"
  >
    <div class="bg-white p-8 rounded-2xl shadow-xl w-full max-w-md space-y-6">
      <h1 class="text-3xl font-bold text-center text-primary">Sign in</h1>
      <p class="text-center text-sm text-text">
        New here? <a href="/register" class="text-accent hover:underline"
          >Create an account</a
        >
      </p>

      <form action="/api/auth/signin" method="post" class="space-y-4">
        <div>
          <label for="email" class="block mb-1 text-sm font-medium text-text"
            >Email</label
          >
          <input
            type="email"
            name="email"
            id="email"
            placeholder="you@example.com"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent"
          />
        </div>

        <div>
          <label for="password" class="block mb-1 text-sm font-medium text-text"
            >Password</label
          >
          <input
            type="password"
            name="password"
            id="password"
            placeholder="Your password"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent"
          />
        </div>

        <button
          type="submit"
          class="w-full py-2 px-4 bg-primary text-white rounded-lg hover:bg-opacity-90 transition"
        >
          Login
        </button>
      </form>

      <div class="relative flex items-center justify-center">
        <span class="absolute w-full border-t border-gray-300 top-1/2"></span>
        <span class="bg-white px-2 text-sm text-text z-10">OR</span>
      </div>

      <form action="/api/auth/signin" method="post">
        <button
          name="provider"
          value="google"
          type="submit"
          class="w-full flex items-center justify-center gap-2 py-2 px-4 border border-gray-300 rounded-lg hover:bg-gray-100 transition"
        >
          <img
            src="https://www.svgrepo.com/show/475656/google-color.svg"
            alt="Google"
            class="w-5 h-5"
          />
          <span>Sign in with Google</span>
        </button>
      </form>
    </div>
  </div>
</Layout>
