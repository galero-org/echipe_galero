---
import Navbar from "../components/Navbar";

const { profile } = Astro.locals;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/galero.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Galero Cup</title>
  </head>
  <body>
    <Navbar client:load profile={profile} />

    <slot />
    <script type="module">
      import { registerSW } from 'virtual:pwa-register';
      registerSW({ immediate: true });
    </script>
  </body>

  <style>
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
    }
  </style>

  <footer class="text-center mt-12 md:mt-16 py-6 border-t border-slate-700">
    <p class="text-sm text-gray-400">
      &copy; {new Date().getFullYear()} Galero Football Iași. Toate drepturile rezervate.
    </p>
    <p class="text-xs text-gray-500 mt-1">
      Construit cu{" "}
      <a href="https://astro.build/" target="_blank" class="hover:text-sky-300">
        Astro
      </a>{" "}
      și pasiune pentru fotbal.
    </p>
  </footer>
</html>
