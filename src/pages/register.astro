---
import Layout from "../layouts/Layout.astro";
const error = Astro.url.searchParams.get("error");
export const prerender = false;
---

<Layout title="Register">
  <div
    class="flex min-h-[calc(100vh-5rem)] items-center justify-center bg-grayLight px-4 py-8 font-text sm:px-6"
  >
    <div
      class="w-full max-w-md space-y-6 rounded-2xl bg-white p-6 shadow-xl sm:p-8"
    >
      <div class="space-y-2 text-center">
        <h1 class="text-3xl font-bold text-primary">Register</h1>
        <p class="text-sm text-text">Creează-ți contul Galero.</p>
      </div>
      {
        error && (
          <p
            class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
            role="alert"
          >
            {error === "missing_credentials"
              ? "Completează emailul și parola."
              : "Contul nu a putut fi creat. Verifică datele și încearcă din nou."}
          </p>
        )
      }
      <p class="text-center text-sm text-text">
        Already have an account?
        <a href="/signin" class="text-accent hover:underline">Sign in</a>
      </p>

      <form action="/api/auth/register" method="post" class="space-y-4">
        <div>
          <label for="email" class="block mb-1 text-sm font-medium text-text"
            >Email</label
          >
          <input
            type="email"
            name="email"
            id="email"
            placeholder="you@example.com"
            required
            autocomplete="email"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent"
          />
        </div>

        <div>
          <label for="password" class="block mb-1 text-sm font-medium text-text"
            >Password</label
          >
          <input
            type="password"
            name="password"
            id="password"
            placeholder="Your password"
            required
            minlength="8"
            autocomplete="new-password"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent"
          />
        </div>

        <button
          type="submit"
          class="w-full rounded-lg bg-primary px-4 py-3 font-semibold text-white transition hover:bg-opacity-90 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
        >
          Register
        </button>
      </form>
    </div>
  </div>
</Layout>
