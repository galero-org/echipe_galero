---
import Layout from "../layouts/Layout.astro";
import { supabase } from "../lib/supabase";
import TeamOrchestrator from "../components/TeamOrchestrator";
import { getAllPlayersPresenceCounts } from "../services/confirmariService";

// --- Preluare Jucători, Ediții, Prezențe, Înregistrări în paralel ---
const [
  { data: allPlayers, error: playersError },
  { data: editions },
  { presenceMap },
] = await Promise.all([
  supabase.from("players").select("*"),
  supabase
    .from("editions")
    .select("id, numar_editie")
    .order("numar_editie", { ascending: false }),
  getAllPlayersPresenceCounts(),
]);

if (playersError) {
  console.error("Error fetching players:", playersError.message);
  return Astro.redirect("/error-page");
}

const editionOptions = editions ?? [];
const registeredPlayersByEdition = new Map<string, Set<string>>();
const registrationPageSize = 1000;

for (let from = 0; ; from += registrationPageSize) {
  const { data: registrations, error: registrationsError } = await supabase
    .from("registrations")
    .select("edition_id, player_id")
    .eq("status", "inscris")
    .order("edition_id")
    .order("player_id")
    .range(from, from + registrationPageSize - 1);

  if (registrationsError || !registrations) {
    console.error("Error fetching registrations:", registrationsError?.message);
    return Astro.redirect("/error-page");
  }

  for (const registration of registrations) {
    const players = registeredPlayersByEdition.get(registration.edition_id);
    if (players) {
      players.add(registration.player_id);
    } else {
      registeredPlayersByEdition.set(
        registration.edition_id,
        new Set([registration.player_id]),
      );
    }
  }

  if (registrations.length < registrationPageSize) break;
}

const registeredPlayerIdsByEdition = Object.fromEntries(
  [...registeredPlayersByEdition].map(([id, players]) => [id, [...players]]),
);

const allPlayersWithPresence = (allPlayers ?? []).map((player) => ({
  ...player,
  totalEditions: presenceMap.get(player.id) ?? 0,
}));
---

<Layout title="Generare Echipe Echilibrate">
  <div class="p-6 max-w-screen-xl mx-auto">
    <h1 class="text-3xl font-bold mb-8 text-center">Generează Echipe</h1>
    {
      allPlayersWithPresence && allPlayersWithPresence.length > 0 ? (
        <TeamOrchestrator
          client:idle
          allPlayers={allPlayersWithPresence}
          editions={editionOptions}
          registeredPlayerIdsByEdition={registeredPlayerIdsByEdition}
        />
      ) : (
        <p class="text-center text-red-500">
          Nu s-au putut încărca jucătorii sau nu există jucători în baza de
          date.
        </p>
      )
    }
  </div>
</Layout>
