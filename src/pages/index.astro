---
import Layout from "../layouts/Layout.astro";

const quickActions = [
  {
    title: "Generează echipe",
    description: "Începe rapid un nou setup pentru meciul de azi.",
    href: "/genereaza",
    accent: "bg-slate-900 text-white",
  },
  {
    title: "Confirmări",
    description: "Urmărește cine este prezent și cine a confirmat.",
    href: "/confirmari",
    accent: "bg-white text-slate-800",
  },
  {
    title: "Statistici",
    description: "Vezi progresul și evoluția echipei într-un loc clar.",
    href: "/statistici",
    accent: "bg-slate-50 text-slate-700",
  },
];
---

<Layout title="Galero Cup">
  <main
    class="min-h-screen bg-[var(--color-background)] px-4 py-10 md:px-6 lg:px-8"
  >
    <section
      class="mx-auto flex max-w-6xl flex-col gap-10 overflow-hidden rounded-3xl border border-slate-200 bg-white p-7 shadow-sm md:p-10 lg:flex-row lg:items-center lg:justify-between"
    >
      <div class="max-w-2xl">
        <p
          class="mb-3 text-sm font-bold uppercase tracking-[0.16em] text-[var(--color-accent)]"
        >
          Fotbal organizat, fără complicații
        </p>
        <h1
          class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl"
        >
          Organizează meciul. Bucură-te de joc.
        </h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          Galero te ajută să aduni jucătorii, să confirmi prezența și să
          generezi echipe echilibrate în câteva minute.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/signin"
            class="inline-flex min-h-11 items-center rounded-lg bg-[var(--color-primary)] px-5 py-3 font-semibold text-white transition hover:bg-[var(--color-primary-hover)]"
          >
            Autentifică-te
          </a>
          <a
            href="/about"
            class="inline-flex items-center rounded-full border border-slate-300 px-5 py-3 font-medium text-slate-700 transition hover:bg-slate-100"
          >
            Cum funcționează
          </a>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
        {
          quickActions.map((action) => (
            <a
              href={action.href}
              class={`rounded-2xl border border-slate-200 p-4 transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-sm ${action.accent}`}
            >
              <h2 class="font-semibold">{action.title}</h2>
              <p class="mt-2 text-sm leading-6 opacity-80">
                {action.description}
              </p>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
