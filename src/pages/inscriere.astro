---
import Layout from "../layouts/Layout.astro";
import JoinForm from "../components/JoinForm.jsx";
---

<Layout title="Inscriere Galero Cup">
  <main class="container mx-auto px-4 py-12 min-h-screen bg-gray-50">
    <div class="text-center mb-8">
      <h1
        class="text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl mb-4"
      >
        Vino la Fotbal!
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Completează formularul de mai jos pentru a intra în legătură cu adminii
        Galero. Te așteptăm pe teren!
      </p>
    </div>

    <JoinForm client:load />
  </main>
</Layout>
